# The Fenrir scheme's background (#000d2a), the same as the login splash that follows.
Window.SetBackgroundTopColor(0.0, 0.051, 0.165);
Window.SetBackgroundBottomColor(0.0, 0.051, 0.165);

# wheel.png is a grid of frames from tools/render-plymouth-wheel.py; keep these in step with it.
wheel.size = 128;
wheel.cols = 10;
wheel.rows = 8;

# About a tenth of the screen height on large screens, never smaller than drawn.
wheel.shown = wheel.size;
if (Window.GetHeight() * 0.11 > wheel.size)
    wheel.shown = Math.Int(Window.GetHeight() * 0.11);

wheel.sheet = Image("wheel.png");
wheel.count = 0;
for (row = 0; row < wheel.rows; row++)
{
    for (col = 0; col < wheel.cols; col++)
    {
        frame = wheel.sheet.Crop(col * wheel.size, row * wheel.size, wheel.size, wheel.size);
        if (wheel.shown != wheel.size)
            frame = frame.Scale(wheel.shown, wheel.shown);
        wheel.frames[wheel.count] = frame;
        wheel.count += 1;
    }
}

# Future logo goes in the middle of the wheel, at z=2.
wheel.sprite = Sprite(wheel.frames[0]);
wheel.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - wheel.shown / 2,
                         Window.GetY() + Window.GetHeight() / 2 - wheel.shown / 2, 1);
wheel.frame = 0;

# Called about 50 times a second, so the 80 frames loop every ~1.6 s.
fun refresh_callback()
{
    wheel.frame += 1;
    if (wheel.frame >= wheel.count)
        wheel.frame = 0;
    wheel.sprite.SetImage(wheel.frames[wheel.frame]);
}

Plymouth.SetRefreshFunction(refresh_callback);
