# Maintainer: Fenrir
pkgname=fenrir-greeter
pkgver=1.0.0
pkgrel=5
pkgdesc="Fenrir's themed QML/Quickshell login screen for greetd"
arch=('x86_64')
license=('GPL-3.0-only')
depends=(
  'quickshell'
  'caelestia-shell'
  'greetd'
  'hyprland'
  'python'
)
source=()

package() {
  # The bridge is a helper, not something anyone runs by hand, so it stays out
  # of PATH.
  install -Dm755 "$startdir/bin/fenrir-greet-bridge" \
    "$pkgdir/usr/lib/fenrir-greeter/fenrir-greet-bridge"

  for f in "$startdir"/qml/*.qml; do
    install -Dm644 "$f" "$pkgdir/etc/xdg/quickshell/fenrir-greeter/$(basename "$f")"
  done
  for f in "$startdir"/qml/services/*.qml; do
    install -Dm644 "$f" "$pkgdir/etc/xdg/quickshell/fenrir-greeter/services/$(basename "$f")"
  done

  # Same trick the installer uses: qs.* resolves against the shell config root,
  # so symlinking Caelestia's trees in makes `import qs.components` the real
  # thing rather than a second copy that drifts.
  ln -s ../caelestia/components "$pkgdir/etc/xdg/quickshell/fenrir-greeter/components"
  ln -s ../caelestia/utils "$pkgdir/etc/xdg/quickshell/fenrir-greeter/utils"

  # The greeter is meant to read as the AFK lock screen, so it imports that
  # module's Clock and ProfilePic rather than reimplementing them. Its
  # PasswordInput and StateMessage can't come along: they declare typed
  # requirements on Pam, which itself requires a real WlSessionLock, so QML
  # rejects a greetd-backed stand-in. Those two are replaced locally.
  install -d "$pkgdir/etc/xdg/quickshell/fenrir-greeter/modules"
  ln -s ../../caelestia/modules/lock \
    "$pkgdir/etc/xdg/quickshell/fenrir-greeter/modules/lock"

  # Clock reads qs.services.Time, which resolves against this config root, not
  # Caelestia's. Self-contained (29 lines, no other services), so link it in
  # beside the local Colours shim.
  ln -s ../../caelestia/services/Time.qml \
    "$pkgdir/etc/xdg/quickshell/fenrir-greeter/services/Time.qml"

  # Deliberately NOT installed to /etc/greetd/config.toml: greetd owns that
  # path, and two packages shipping one file is a hard conflict pacman will not
  # install through. The live image never runs greetd anyway; backend.py's
  # configure_greeter() copies this onto the target at install time.
  install -Dm644 "$startdir/config/config.toml" \
    "$pkgdir/usr/share/fenrir-greeter/config.toml"
  install -Dm644 "$startdir/config/hyprland.lua" "$pkgdir/etc/greetd/hyprland.lua"
  install -Dm644 "$startdir/config/layout.lua" "$pkgdir/etc/greetd/layout.lua"
}
