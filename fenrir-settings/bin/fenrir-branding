#!/bin/sh
# Run by zz-fenrir-branding.hook, after cachyos-hooks has set these to CachyOS.
set -eu
install -m644 /usr/share/fenrir/os-release /etc/os-release
if [ -f /etc/lsb-release ]; then
    sed -i -e 's|^DISTRIB_ID=.*$|DISTRIB_ID=fenrir|' -e 's|^DISTRIB_DESCRIPTION=.*$|DISTRIB_DESCRIPTION="Fenrir"|' /etc/lsb-release
fi
