#!/bin/sh
# Root side of Settings > Updates and the welcome window's extras; only knows the jobs below.
# Jobs run as the fenrir-pkg system unit, logged to /run/fenrir-pkg, so a shell reload or logout can't kill pacman.
set -eu
# pkexec keeps the caller's umask, and the shell has to read the files below.
umask 022

# bundle: the packages it installs, or "chwd" for hardware detection
bundles() {
    cat <<'EOF'
gaming cachyos-gaming-applications
flatpak flatpak
printers gutenprint hplip foomatic-db foomatic-db-engine foomatic-db-ppds
codecs gst-plugins-bad gst-plugins-ugly gst-libav
devtools base-devel
graphics chwd
EOF
}

# Always a full -Syu: installs ship without sync databases, and a bare -S would be a partial upgrade.
case "${1:-}" in
    list)
        bundles
        exit 0
        ;;
    update)
        job="update"
        cmd="pacman -Syu --noconfirm --noprogressbar"
        ;;
    install)
        pkgs="$(bundles | awk -v b="${2:-}" '$1 == b { $1 = ""; print }')"
        [ -n "$pkgs" ] || { echo "Unknown extra: ${2:-}" >&2; exit 2; }
        job="install ${2}"
        if [ "$pkgs" = " chwd" ]; then
            cmd="pacman -Syu --noconfirm --noprogressbar && chwd -a"
        else
            cmd="pacman -Syu --needed --noconfirm --noprogressbar$pkgs"
        fi
        ;;
    *)
        echo "usage: $0 list | update | install <extra>" >&2
        exit 2
        ;;
esac

dir=/run/fenrir-pkg
mkdir -p "$dir"
chmod 755 "$dir"

# Held until the unit is up, so two starts can't both pass the check and clobber each other's files.
exec 9> "$dir/lock"
if ! flock -n 9 || systemctl is-active --quiet fenrir-pkg.service; then
    echo "Another install is already running" >&2
    exit 1
fi

echo "$job" > "$dir/job"
echo running > "$dir/state"
: > "$dir/log"
# Done only once pacman exits, after fenrir-update-guard's hook has synced the files to disk.
if ! systemd-run --unit=fenrir-pkg --collect --quiet -p ManagedOOMPreference=omit \
    sh -c "{ $cmd; } > $dir/log 2>&1; echo \$? > $dir/state"; then
    echo 1 > "$dir/state"
    exit 1
fi
