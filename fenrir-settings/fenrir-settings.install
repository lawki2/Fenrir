# Printing: .local names through avahi, and the services it needs.
setup_printing() {
    if ! grep -q '^hosts:.*mdns_minimal' /etc/nsswitch.conf; then
        sed -i '/^hosts:/s/ resolve / mdns_minimal [NOTFOUND=return] resolve /' /etc/nsswitch.conf
        grep -q '^hosts:.*mdns_minimal' /etc/nsswitch.conf \
            || echo "fenrir-settings: add 'mdns_minimal [NOTFOUND=return]' to the hosts line in /etc/nsswitch.conf for network printers"
    fi
    systemctl enable --now avahi-daemon.service cups.socket 2>/dev/null || true
    systemctl try-restart systemd-resolved.service 2>/dev/null || true
}

# Installs from before this package kept a frozen copy of the dotfiles in every home.
migrate_homes() {
    skel=/etc/skel
    if [ -L "$skel/.config/hypr" ]; then
        rm -f "$skel/.config/hypr" "$skel/.config/fish" "$skel/.config/foot" "$skel/.config/fastfetch" "$skel/.config/starship.toml"
        for app in btop uwsm; do
            if [ -L "$skel/.config/$app" ]; then
                rm "$skel/.config/$app"
                cp -r "$skel/.local/share/caelestia/$app" "$skel/.config/$app"
            fi
        done
        mkdir -p "$skel/.config/hypr"
        ln -s /usr/share/fenrir/hypr-loader.lua "$skel/.config/hypr/hyprland.lua"
        rm -rf "$skel/.local/share/caelestia"
    fi

    # As each user, so nothing in a home can steer root's file operations.
    getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $6 ~ /^\/home\// { print $1 ":" $6 }' |
        while IFS=: read -r user home; do
            [ -d "$home" ] || continue
            runuser -u "$user" -- env HOME="$home" /usr/lib/fenrir/fenrir-migrate-home \
                || echo "fenrir-settings: couldn't move $home to the shipped config; it keeps its old copy"
        done
}

# Installs made by copying the live ISO also copied its live-only boot setup. The worst part
# rebuilt the pacman keyring on a tmpfs at every boot, which dropped the Fenrir repo key.
repair_live_leftovers() {
    [ -f /etc/fenrir-packages.x86_64 ] && return

    systemctl disable pacman-init.service livecd-talk.service livecd-alsa-unmuter.service 2>/dev/null || true
    rm -f /etc/systemd/system/pacman-init.service /etc/systemd/system/etc-pacman.d-gnupg.mount \
        /etc/systemd/system/livecd-talk.service /etc/systemd/system/livecd-alsa-unmuter.service \
        /etc/systemd/journald.conf.d/volatile-storage.conf /etc/systemd/logind.conf.d/do-not-suspend.conf
    if mountpoint -q /etc/pacman.d/gnupg; then
        gpgconf --homedir /etc/pacman.d/gnupg --kill all 2>/dev/null || true
        umount -l /etc/pacman.d/gnupg
    fi
    fpr=BE0B53BD597DF2CDB8437E869C17423CED27E4BE
    if ! pacman-key --list-keys "$fpr" >/dev/null 2>&1 && [ -f /etc/pacman.d/fenrir-signing-key.asc ]; then
        pacman-key --add /etc/pacman.d/fenrir-signing-key.asc && pacman-key --lsign-key "$fpr"
    fi

    # Only the live ISO's own versions, so nothing a user set up is touched.
    grep -q 'PermitRootLogin yes' /etc/ssh/sshd_config.d/10-archiso.conf 2>/dev/null \
        && rm -f /etc/ssh/sshd_config.d/10-archiso.conf && systemctl try-reload-or-restart sshd.service 2>/dev/null
    grep -q 'autologin liveuser' /etc/systemd/system/getty@tty1.service.d/autologin.conf 2>/dev/null \
        && rm -rf /etc/systemd/system/getty@tty1.service.d
    grep -q 'Installation Environment' /etc/motd 2>/dev/null && rm -f /etc/motd
    grep -q 'automated_script' /root/.zlogin 2>/dev/null && rm -f /root/.zlogin /root/.automated_script.sh
    # The installer's password-required wheel rule has to exist, or this would remove sudo.
    [ -f /etc/sudoers.d/wheel ] && rm -f /etc/sudoers.d/g_wheel
    systemctl daemon-reload 2>/dev/null || true
}

# Without quiet, Limine prints a line each for the kernel and initramfs ahead of the splash.
# An explicit quiet: line is the user's choice and is left alone.
quiet_limine() {
    conf=/boot/limine.conf
    [ -f "$conf" ] || return 0
    grep -q '^[[:space:]]*quiet:' "$conf" || sed -i '1i quiet: yes' "$conf"
}

setup_snapshots() {
    # Not in a chroot or container: that's the ISO or a package build, and the installer runs it itself.
    systemd-detect-virt --chroot -q || systemd-detect-virt --container -q \
        || /usr/lib/fenrir/fenrir-setup-snapshots || echo "fenrir-settings: snapshot setup failed; updates still work, without rollback"
}

# Keeps firmware update info current for Settings > Updates.
enable_fwupd_refresh() {
    systemctl enable --now fwupd-refresh.timer 2>/dev/null || true
}

# Closes the app hogging memory before the whole system stalls; see the oomd drop-ins.
enable_oomd() {
    systemctl enable --now systemd-oomd.service 2>/dev/null || true
}

# ydotoold for the alternate paste bind; 70-fenrir-uinput.rules gives it /dev/uinput.
enable_ydotool() {
    systemctl --global enable ydotool.service 2>/dev/null || true
}

post_install() {
    repair_live_leftovers
    quiet_limine
    setup_snapshots
    enable_fwupd_refresh
    enable_oomd
    enable_ydotool
    setup_printing
    migrate_homes
}

# $1 is older than $2
older() {
    [ "$(vercmp "$1" "$2")" -lt 0 ]
}

# Only the steps added since the old version ($2), so services a user turned off stay off.
post_upgrade() {
    if older "$2" 2026.09.24.1359; then
        enable_fwupd_refresh
        setup_printing
        migrate_homes
    fi
    # Installs from ISOs before the installer skipped live-only files, or ran the snapshot setup.
    if older "$2" 2026.09.24.1814; then
        repair_live_leftovers
        setup_snapshots
    fi
    if older "$2" 2026.09.24.2228; then
        enable_oomd
    fi
    if older "$2" 2026.09.25.1544; then
        quiet_limine
        enable_ydotool
    fi
}
